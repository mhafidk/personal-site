---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../data/site';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );

  return posts.map((post, idx) => ({
    params: { id: post.id },
    props: {
      post,
      prevPost: posts[idx + 1] ?? null,
      nextPost: posts[idx - 1] ?? null,
    },
  }));
}

const { post, prevPost, nextPost } = Astro.props;
const { Content, headings } = await render(post);

const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);

const wordCount = (post.body ?? '').trim().split(/\s+/).length;
const readingMinutes = Math.max(1, Math.round(wordCount / 200));

function formatDate(date: Date): string {
  return date.toISOString().slice(0, 10);
}

const siteOrigin = Astro.site ?? new URL(Astro.url.origin);
const articleUrl = new URL(Astro.url.pathname, siteOrigin).toString();
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  ...(post.data.updatedDate
    ? { dateModified: post.data.updatedDate.toISOString() }
    : {}),
  ...(post.data.image
    ? { image: new URL(post.data.image, siteOrigin).toString() }
    : {}),
  url: articleUrl,
  author: {
    '@type': 'Person',
    name: SITE.fullName,
    url: siteOrigin.toString(),
  },
};
---

<BaseLayout
  title={`${post.data.title} · ${SITE.name}`}
  description={post.data.description}
  image={post.data.image}
  type="article"
  publishedTime={post.data.pubDate.toISOString()}
  jsonLd={articleJsonLd}
>
  <article>
    <header class="pb-8 border-b border-[#1a202c]">
      <div class="flex flex-wrap items-center gap-3 font-mono text-xs text-[#9aa5b8] tabular-nums">
        <a
          href="/blog"
          class="text-[#6cb6ff] transition hover:text-[#96cbff]"
        >
          &larr; All Writing
        </a>
        <span>·</span>
        <time datetime={post.data.pubDate.toISOString()}>
          {formatDate(post.data.pubDate)}
        </time>
        <span>·</span>
        <span>{readingMinutes} min read</span>
      </div>

      <h1 class="mt-4 text-2xl font-semibold tracking-tight text-[#eceff4] sm:text-3xl leading-snug">
        {post.data.title}
      </h1>

      <p class="mt-3 max-w-[65ch] text-base leading-relaxed text-[#9aa5b8]">
        {post.data.description}
      </p>

      {
        post.data.tags.length > 0 && (
          <div class="mt-4 flex flex-wrap gap-1.5">
            {post.data.tags.map((tag) => (
              <span class="rounded border border-[#222938] bg-[#10141b] px-2 py-0.5 font-mono text-[11px] text-[#9aa5b8]">
                #{tag}
              </span>
            ))}
          </div>
        )
      }

      {
        post.data.image && (
          <figure class="mt-7 overflow-hidden rounded-lg border border-[#1e2430] bg-[#10141b]">
            <img
              src={post.data.image}
              alt={post.data.title}
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="max-h-[26rem] w-full object-cover"
            />
          </figure>
        )
      }
    </header>

    <div
      class:list={[
        'mt-10',
        tocHeadings.length > 0
          ? 'lg:grid lg:grid-cols-[minmax(0,1fr)_14.5rem] lg:items-start lg:gap-12'
          : '',
      ]}
    >
      {
        tocHeadings.length > 0 && (
          <details
            open
            class="mb-8 rounded-lg border border-[#1e2430] bg-[#10141b] p-4 lg:hidden"
          >
            <summary class="cursor-pointer select-none font-mono text-xs font-medium text-[#eceff4]">
              Table of Contents
            </summary>
            <nav aria-label="Table of contents" class="mt-3">
              <ul class="space-y-2 border-l border-[#222938] pl-3.5 text-xs">
                {tocHeadings.map((heading) => (
                  <li class:list={[heading.depth === 3 ? 'pl-3' : '']}>
                    <a
                      href={`#${heading.slug}`}
                      class="block text-[#9aa5b8] transition-colors hover:text-[#6cb6ff]"
                    >
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </details>
        )
      }

      <div class="prose-technical min-w-0">
        <Content />
      </div>

      {
        tocHeadings.length > 0 && (
          <aside
            aria-label="Table of contents"
            class="hidden lg:sticky lg:top-20 lg:block"
          >
            <div class="font-mono text-xs font-medium text-[#eceff4]">
              On this page
            </div>
            <nav class="mt-3">
              <ul class="space-y-2 border-l border-[#1e2430] pl-3.5 text-xs leading-snug">
                {tocHeadings.map((heading) => (
                  <li class:list={[heading.depth === 3 ? 'pl-3' : '']}>
                    <a
                      href={`#${heading.slug}`}
                      data-toc-link={heading.slug}
                      class="toc-link block text-[#9aa5b8] transition-colors hover:text-[#eceff4]"
                    >
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </aside>
        )
      }
    </div>

    <nav
      aria-label="Adjacent articles"
      class="mt-16 grid grid-cols-1 gap-4 border-t border-[#1a202c] pt-8 sm:grid-cols-2"
    >
      {
        prevPost ? (
          <a
            href={`/blog/${prevPost.id}`}
            class="group rounded-md border border-[#1e2430] bg-[#10141b] p-4 transition hover:border-[#343f54]"
          >
            <div class="font-mono text-xs text-[#9aa5b8]">&larr; Older note</div>
            <div class="mt-1 text-sm font-medium text-[#eceff4] group-hover:text-[#6cb6ff] transition-colors">
              {prevPost.data.title}
            </div>
          </a>
        ) : (
          <div />
        )
      }

      {
        nextPost && (
          <a
            href={`/blog/${nextPost.id}`}
            class="group rounded-md border border-[#1e2430] bg-[#10141b] p-4 text-left sm:text-right transition hover:border-[#343f54]"
          >
            <div class="font-mono text-xs text-[#9aa5b8]">Newer note &rarr;</div>
            <div class="mt-1 text-sm font-medium text-[#eceff4] group-hover:text-[#6cb6ff] transition-colors">
              {nextPost.data.title}
            </div>
          </a>
        )
      }
    </nav>
  </article>
</BaseLayout>

<script>
  const tocLinks = document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]');
  if (tocLinks.length > 0) {
    const setActive = (slug: string) => {
      tocLinks.forEach((link) => {
        const isMatch = link.getAttribute('data-toc-link') === slug;
        link.classList.toggle('text-[#6cb6ff]', isMatch);
        link.classList.toggle('font-medium', isMatch);
        link.classList.toggle('text-[#9aa5b8]', !isMatch);
      });
    };

    const headingElements = Array.from(tocLinks)
      .map((link) => {
        const slug = link.getAttribute('data-toc-link');
        return slug ? document.getElementById(slug) : null;
      })
      .filter((el): el is HTMLElement => el !== null);

    if (headingElements.length > 0) {
      setActive(headingElements[0].id);

      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              setActive(entry.target.id);
              break;
            }
          }
        },
        {
          rootMargin: '-80px 0px -70% 0px',
          threshold: 0,
        }
      );

      headingElements.forEach((el) => observer.observe(el));
    }
  }
</script>
