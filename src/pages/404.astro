---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';
---

<BaseLayout
  title={`404 — Page Not Found · ${SITE.name}`}
  description="The requested page could not be found."
>
  <section class="flex min-h-[60vh] flex-col items-start justify-center py-12">
    <div class="inline-flex items-center gap-2 rounded border border-[#222938] bg-[#10141b] px-2.5 py-1 font-mono text-xs text-[#6cb6ff]">
      <span>HTTP 404</span>
      <span class="text-[#2d3648]">·</span>
      <span class="text-[#9aa5b8]">NOT_FOUND</span>
    </div>

    <h1 class="mt-5 text-3xl font-semibold tracking-tight text-[#eceff4] sm:text-4xl">
      Page not found
    </h1>

    <p class="mt-3 max-w-[54ch] text-sm leading-relaxed text-[#9aa5b8] sm:text-base">
      The page you are looking for doesn't exist, may have been moved, or the URL might be mistyped.
    </p>

    <div class="mt-8 flex flex-wrap items-center gap-3.5 text-xs">
      <a
        href="/"
        class="rounded-md bg-[#eceff4] px-4 py-2.5 font-medium text-[#0a0c10] transition hover:bg-white"
      >
        &larr; Back to Home
      </a>
      <a
        href="/blog"
        class="rounded-md border border-[#252c3a] bg-[#10141b] px-4 py-2.5 font-medium text-[#eceff4] transition hover:border-[#384357] hover:bg-[#161b24]"
      >
        Read Technical Writing
      </a>
      <button
        type="button"
        data-open-search
        class="rounded-md border border-[#222938] bg-[#0d1017] px-4 py-2.5 font-mono text-[#9aa5b8] transition hover:border-[#343f54] hover:text-[#eceff4]"
      >
        Search (⌘K)
      </button>
    </div>
  </section>
</BaseLayout>
