---
import "../styles/global.css";
import { SITE } from "../data/site";
import SearchModal from "../components/SearchModal.astro";

interface Props {
    title?: string;
    description?: string;
    image?: string;
    type?: "website" | "article";
    publishedTime?: string;
    fullViewport?: boolean;
    jsonLd?: Record<string, unknown>;
}

const {
    title = SITE.title,
    description = SITE.description,
    image = "/og-default.png",
    type = "website",
    publishedTime,
    fullViewport = false,
    jsonLd,
} = Astro.props;

const pathname = Astro.url.pathname;
const siteOrigin = Astro.site ?? new URL(Astro.url.origin);
const canonicalURL = new URL(pathname, siteOrigin);
const socialImageURL = new URL(image, siteOrigin).toString();

const defaultJsonLd = {
    "@context": "https://schema.org",
    "@type": "Person",
    name: SITE.fullName,
    alternateName: SITE.name,
    jobTitle: SITE.role,
    url: siteOrigin.toString(),
    sameAs: SITE.socials.map((s) => s.href),
};

const structuredData = jsonLd ?? defaultJsonLd;
---

<!doctype html>
<html lang="en" class="dark">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="color-scheme" content="dark" />
        <meta name="theme-color" content="#0a0c10" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="canonical" href={canonicalURL} />
        <link
            rel="alternate"
            type="application/rss+xml"
            title={SITE.title}
            href={new URL("/rss.xml", siteOrigin)}
        />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
            rel="stylesheet"
        />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <meta name="description" content={description} />

        <!-- OpenGraph -->
        <meta property="og:type" content={type} />
        <meta property="og:site_name" content={SITE.fullName} />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={socialImageURL} />
        {
            type === "article" && publishedTime && (
                <meta property="article:published_time" content={publishedTime} />
            )
        }

        <!-- Twitter / X Cards -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={socialImageURL} />

        <!-- JSON-LD Structured Data -->
        <script
            type="application/ld+json"
            set:html={JSON.stringify(structuredData)}
        />
    </head>
    <body class="flex min-h-screen flex-col bg-[#0a0c10] text-[#eceff4] selection:bg-[#6cb6ff]/25">
        <header
            id="site-navbar"
            class="sticky top-0 z-30 border-b border-[#1a202c] bg-[#0a0c10]/90 backdrop-blur-md transition-transform duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] will-change-transform"
        >
            <div class="mx-auto flex max-w-4xl items-center justify-between px-5 py-4 sm:px-8">
                <a
                    href="/"
                    class="group flex items-baseline gap-2.5 text-lg font-semibold tracking-tight text-[#eceff4]"
                >
                    <span class="font-mono text-lg font-bold text-[#eceff4] group-hover:text-[#6cb6ff] transition-colors">
                        {SITE.name}
                    </span>
                </a>

                <div class="flex items-center gap-5 sm:gap-6">
                    <nav
                        aria-label="Primary"
                        class="flex items-center gap-5 text-xs font-medium"
                    >
                        <a
                            href="/"
                            class:list={[
                                "transition-colors",
                                pathname === "/"
                                    ? "text-[#eceff4]"
                                    : "text-[#9aa5b8] hover:text-[#eceff4]",
                            ]}
                        >
                            Home
                        </a>
                        <a
                            href="/projects"
                            class:list={[
                                "transition-colors",
                                pathname.startsWith("/projects")
                                    ? "text-[#eceff4]"
                                    : "text-[#9aa5b8] hover:text-[#eceff4]",
                            ]}
                        >
                            Portfolio
                        </a>
                        <a
                            href="/blog"
                            class:list={[
                                "transition-colors",
                                pathname.startsWith("/blog")
                                    ? "text-[#eceff4]"
                                    : "text-[#9aa5b8] hover:text-[#eceff4]",
                            ]}
                        >
                            Writing
                        </a>
                    </nav>

                    <button
                        type="button"
                        data-open-search
                        class="flex items-center gap-2.5 rounded-md border border-[#222938] bg-[#10141b] px-2.5 py-1.5 text-xs text-[#9aa5b8] transition hover:border-[#343f54] hover:text-[#eceff4]"
                        aria-label="Search site (Command + K or /)"
                    >
                        <svg
                            class="h-3.5 w-3.5 text-[#9aa5b8]"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                        >
                            <circle cx="11" cy="11" r="8"></circle>
                            <path d="m21 21-4.3-4.3"></path>
                        </svg>
                        <span class="hidden sm:inline">Search</span>
                        <kbd class="rounded border border-[#252c3a] bg-[#161b24] px-1.5 py-0.5 font-mono text-xs text-[#9aa5b8]">
                            ⌘K
                        </kbd>
                    </button>
                </div>
            </div>
        </header>

        <main
            class:list={[
                "w-full flex-1",
                fullViewport
                    ? ""
                    : "mx-auto max-w-4xl px-5 py-12 sm:px-8 sm:py-16",
            ]}
        >
            <slot />
        </main>

        <footer class="border-t border-[#1a202c] py-10 text-xs text-[#9aa5b8]">
            <div class="mx-auto flex max-w-4xl flex-col justify-between gap-4 px-5 sm:flex-row sm:items-center sm:px-8">
                <div>
                    <span class="font-medium text-[#eceff4]">{SITE.name}</span>
                    <span class="mx-2 text-[#2d3648]">·</span>
                    <span>Software Engineer</span>
                </div>
                <div class="flex flex-wrap items-center gap-5">
                    {SITE.socials.map((item) => (
                        <a
                            href={item.href}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-[#9aa5b8] transition-colors hover:text-[#eceff4]"
                        >
                            {item.label}
                        </a>
                    ))}
                    <a
                        href="/rss.xml"
                        class="text-[#9aa5b8] transition-colors hover:text-[#eceff4]"
                    >
                        RSS
                    </a>
                </div>
            </div>
        </footer>

        <SearchModal />

        <script>
            const navbar = document.getElementById("site-navbar");
            if (navbar) {
                let lastScrollY = window.scrollY;
                let ticking = false;

                const updateNavbar = () => {
                    const currentScrollY = window.scrollY;
                    const delta = currentScrollY - lastScrollY;

                    if (currentScrollY <= 48) {
                        navbar.classList.remove("-translate-y-full");
                    } else if (delta > 6) {
                        navbar.classList.add("-translate-y-full");
                    } else if (delta < -6) {
                        navbar.classList.remove("-translate-y-full");
                    }

                    lastScrollY = Math.max(0, currentScrollY);
                    ticking = false;
                };

                window.addEventListener(
                    "scroll",
                    () => {
                        if (!ticking) {
                            window.requestAnimationFrame(updateNavbar);
                            ticking = true;
                        }
                    },
                    { passive: true },
                );

                navbar.addEventListener("focusin", () => {
                    navbar.classList.remove("-translate-y-full");
                });
            }
        </script>
    </body>
</html>
