---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  headingLevel?: 'h2' | 'h3';
  compact?: boolean;
}

const {
  post,
  headingLevel = 'h2',
  compact = false,
} = Astro.props;

const HeadingTag = headingLevel;

function formatDate(date: Date): string {
  return date.toISOString().slice(0, 10);
}
---

<article
  class:list={[
    'blog-post-row transition',
    compact ? 'py-5 first:pt-5 last:pb-5' : 'py-7',
  ]}
  data-tags={post.data.tags.join(',')}
>
  <a
    href={`/blog/${post.id}`}
    class:list={[
      'group flex flex-col sm:flex-row sm:items-start sm:justify-between',
      compact ? 'gap-4' : 'gap-5',
    ]}
  >
    {
      post.data.image && (
        <div
          class:list={[
            'aspect-[3/2] w-full shrink-0 overflow-hidden rounded-md border border-[#1e2430] bg-[#10141b]',
            compact ? 'sm:w-40' : 'sm:w-44',
          ]}
        >
          <img
            src={post.data.image}
            alt={post.data.title}
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover transition duration-300 group-hover:scale-[1.03]"
          />
        </div>
      )
    }

    <div class="min-w-0 flex-1">
      <HeadingTag
        class:list={[
          'text-[#eceff4] group-hover:text-[#6cb6ff] transition-colors',
          compact ? 'text-base font-medium' : 'text-lg font-semibold',
        ]}
      >
        {post.data.title}
      </HeadingTag>

      <time
        datetime={post.data.pubDate.toISOString()}
        class="mt-1 block font-mono text-xs text-[#9aa5b8] tabular-nums"
      >
        {formatDate(post.data.pubDate)}
      </time>

      <p class="mt-2 max-w-[68ch] text-sm leading-relaxed text-[#9aa5b8]">
        {post.data.description}
      </p>

      <div class="mt-3 flex flex-wrap gap-1.5">
        {
          post.data.tags.map((tag) => (
            <span class="rounded border border-[#222938] bg-[#10141b] px-2 py-0.5 font-mono text-[11px] text-[#9aa5b8]">
              #{tag}
            </span>
          ))
        }
      </div>
    </div>
  </a>
</article>
